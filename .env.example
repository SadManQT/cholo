# Copy this file to .env and fill in real values. .env is git-ignored —
# never commit it (doc 07 §2).

# --- Postgres (read by docker-compose.yml) ---
POSTGRES_USER=cholo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cholo
POSTGRES_PORT=5433

# --- Backend (read later by server/config/env.js, doc 08 §5) ---
# Built from the four values above; must match them.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://cholo:change-me@localhost:5433/cholo

# Copy this file to .env and fill in real values. .env is git-ignored —
# never commit it (doc 07 §2).

# --- Postgres (read by docker-compose.yml) ---
POSTGRES_USER=cholo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cholo
POSTGRES_PORT=5433

# --- Backend (read later by server/config/env.js, doc 08 §5) ---
# Built from the four values above; must match them.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://cholo:change-me@localhost:5433/cholo
CLIENT_ORIGIN=http://localhost:5173

# --- Auth (doc 10) ---
# 32+ random chars; generate with `openssl rand -base64 48`. Never reuse
# across environments.
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# Copy this file to .env and fill in real values. .env is git-ignored —
# never commit it (doc 07 §2).

# --- Postgres (read by docker-compose.yml) ---
POSTGRES_USER=cholo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cholo
POSTGRES_PORT=5433

# --- Backend (read later by server/config/env.js, doc 08 §5) ---
# Built from the four values above; must match them.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://cholo:change-me@localhost:5433/cholo
CLIENT_ORIGIN=http://localhost:5173

# --- Auth (doc 10) ---
# 32+ random chars; generate with `openssl rand -base64 48`. Never reuse
# across environments.
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# --- Geo abstraction (doc 05-06-07 §8) ---
# 'osm' is the only implemented provider; defaults below are the free public
# demo servers (fine for dev, rate-limited — see Nominatim's usage policy
# before relying on this in anything real).
GEO_PROVIDER=osm
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# --- Payment gateway abstraction (doc 05-06-07 §8's adapter pattern) ---
# 'sslcommerz' is the only implemented provider. store_id/store_passwd
# below are SSLCommerz's own published universal sandbox credentials
# (developer.sslcommerz.com) — not secrets, work with zero signup, shared
# by everyone testing against their sandbox. Register your own sandbox
# store there if you want transactions isolated to just you.
PAYMENT_GATEWAY=sslcommerz
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
# Must be a publicly reachable URL — SSLCommerz's servers POST the IPN
# webhook here. localhost only works behind a tunnel (e.g. ngrok) in dev.
PUBLIC_API_ORIGIN=http://localhost:3000
